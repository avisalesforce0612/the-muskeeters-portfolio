# Copy this file to .env.local and add the API key.
# The band's Drive folder ID is already configured in src/siteConfig.ts;
# set this only if you need to override it.
# Share the Drive folder as "Anyone with the link — Viewer".
# Enable Google Drive API v3 for a Google Cloud project, then create an API key
# restricted to the Drive API and your website's HTTP referrers.
# This browser key is visible in the built site; never grant it write access.
# VITE_GOOGLE_DRIVE_FOLDER_ID=your_folder_id_override
# VITE_GOOGLE_DRIVE_API_KEY=your_referrer_restricted_read_only_key
